{
  "manifest_version": 3,
  "name": "Instagram Reels Control",
  "version": "1.0.1",
  "description": "Full video playback controls for Instagram Reels: seek bar, volume control, playback speed, Picture-in-Picture, auto-scroll, and hotkeys.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.instagram.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Reels Control",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/Tiny5-Regular.ttf"
      ],
      "matches": [
        "https://*.instagram.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
